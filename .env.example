# Copiar a .env y completar. .env NO se sube al repositorio (está en .gitignore).
# En Google Colab no hace falta .env: la clave se carga desde Secrets (ver notebooks/pe2_colab.ipynb).

# Proveedor del modelo: gemini | anthropic | openai | mock (mock funciona sin API key)
PROVEEDOR=gemini
MODELO=gemini-3.1-flash-lite

# Clave del proveedor elegido (para Gemini también sirve GOOGLE_API_KEY)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Solo si el MODELO no está en la tabla de precios de src/motor.py (USD por millón de tokens)
PRECIO_INPUT_MTOK=
PRECIO_OUTPUT_MTOK=

# Opcional
LOG_LEVEL=INFO

# Asistente web (Vercel): clave de acceso → rol. El rol lo decide el servidor, no el navegador.
CLAVES_ROLES=operario:cambiar1,supervisor:cambiar2,gerencia:cambiar3
